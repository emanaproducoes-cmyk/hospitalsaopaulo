/* ==========================================================
   figures.css — estilo compartilhado das figuras desenhadas em SVG/CSS
   Usa as variáveis do site (--navy, --red, --line, --muted) com valores de reserva.
   ========================================================== */

.fig {
  --f-navy: var(--navy, #0b1a40);
  --f-red: var(--red, #a31621);
  --f-line: var(--line, #dfe2ee);
  --f-muted: var(--muted, #5b6180);
  --f-blue: #0a1f8f;
  --f-outer: #e1e3f1;
  --f-outer-hover: #c9cfea;
  --f-inner: #cfd5ec;
  --f-inner-hover: #b4bee3;
  --f-bg: #fff;

  margin: 0;
  padding: clamp(18px, 3vw, 36px);
  background: var(--f-bg);
  border: 1px solid var(--f-line);
  border-radius: 18px;
}

.fig-heading {
  margin: 0 0 18px;
  color: var(--f-navy);
  font-size: clamp(14px, 1.6vw, 19px);
  font-weight: 700;
  letter-spacing: -0.01em;
}

.fig figcaption {
  margin-top: 18px;
  color: var(--f-muted);
  font-size: 14px;
  font-style: italic;
}

/* ---------- Mapa de ambiente ---------- */
.amb-wrap {
  position: relative;
  max-width: 880px;
  margin: 0 auto;
}

.amb-svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
  font-family: inherit;
  user-select: none;
}

.amb-node,
.amb-core {
  cursor: pointer;
  outline: none;
  transition: opacity 0.25s ease;
}

.amb-wedge {
  stroke: var(--f-bg);
  stroke-width: 3;
  transition: fill 0.25s ease;
}
.amb-outer .amb-wedge { fill: var(--f-outer); }
.amb-inner .amb-wedge { fill: var(--f-inner); }
.amb-outer.is-active .amb-wedge,
.amb-outer:focus-visible .amb-wedge { fill: var(--f-outer-hover); }
.amb-inner.is-active .amb-wedge,
.amb-inner:focus-visible .amb-wedge { fill: var(--f-inner-hover); }

.amb-node:focus-visible .amb-wedge,
.amb-core:focus-visible .amb-core-disc {
  stroke: var(--f-red);
  stroke-width: 3;
}

/* Hover: o resto do mapa esmaece */
.amb-svg.has-active .amb-node:not(.is-active),
.amb-svg.has-active .amb-core:not(.is-active) { opacity: 0.5; }

.amb-text { pointer-events: none; transition: fill 0.25s ease; }
.amb-t-title { fill: var(--f-blue); font-size: 17px; font-weight: 700; }
.amb-t-desc  { fill: #3b4261; font-size: 13.5px; }
.amb-t-inner { fill: var(--f-navy); font-size: 15px; font-weight: 700; }
.amb-node.is-active .amb-t-title,
.amb-node.is-active .amb-t-inner { fill: var(--f-red); }

/* Núcleo */
.amb-core-disc { fill: var(--f-navy); stroke: var(--f-bg); stroke-width: 4; transition: transform 0.3s ease; transform-box: fill-box; transform-origin: center; }
.amb-core.is-active .amb-core-disc { transform: scale(1.05); }
.amb-core-halo { fill: none; stroke: var(--f-navy); stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
.amb-core.is-active .amb-core-halo { opacity: 0.25; }
.amb-core-text { fill: #fff; font-size: 22px; font-weight: 700; pointer-events: none; }

/* ---------- Tooltip ---------- */
.amb-tip {
  position: absolute;
  z-index: 5;
  width: max-content;
  max-width: min(280px, 70vw);
  padding: 12px 16px 14px;
  background: var(--f-navy);
  color: #fff;
  border-radius: 12px;
  box-shadow: 0 14px 34px rgba(11, 26, 64, 0.28);
  pointer-events: none;
  animation: amb-tip-in 0.18s ease both;
  /* nunca sai das bordas da figura */
  --half: 140px;
  left: clamp(var(--half), var(--left, 50%), calc(100% - var(--half)));
}
.amb-tip.is-above { transform: translate(-50%, calc(-100% - 18px)); }
.amb-tip.is-below { transform: translate(-50%, 18px); }
.amb-tip strong { display: block; font-size: 15px; line-height: 1.3; }
.amb-tip p { margin: 6px 0 0; font-size: 13.5px; line-height: 1.5; color: #d6dbf2; }
.amb-tip-tag { display: block; margin-bottom: 4px; color: #ff9aa2; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }

@keyframes amb-tip-in { from { opacity: 0; } to { opacity: 1; } }

/* ---------- Lista (telas pequenas) ---------- */
.amb-list { display: none; }

@media (max-width: 640px) {
  .amb-wrap { display: none; }
  .amb-list { display: grid; gap: 22px; }
  .amb-list h4 { margin: 0 0 10px; color: var(--f-red); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }
  .amb-list ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .amb-list li { display: grid; gap: 2px; padding: 12px 14px; background: #f4f5fa; border-left: 3px solid var(--f-red); border-radius: 8px; }
  .amb-list strong { color: var(--f-navy); font-size: 15px; }
  .amb-list span { color: var(--f-muted); font-size: 14px; line-height: 1.5; }
}

@media (prefers-reduced-motion: reduce) {
  .amb-node, .amb-core, .amb-wedge, .amb-text, .amb-core-disc { transition: none; }
  .amb-tip { animation: none; }
}
